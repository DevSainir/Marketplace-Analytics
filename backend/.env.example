# ---------------------------------------------------------------------------
# Marketplace Service — environment template.
# Copy to `.env` and fill real secrets. NEVER commit the populated `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Marketplace Service"
ENVIRONMENT=local            # local | staging | production
# NEVER true in production: exposes interactive tracebacks and echoes SQL.
# (Startup fails if ENVIRONMENT=production and DEBUG=true.)
DEBUG=false
LOG_LEVEL=INFO
# One JSON object per line instead of the human column format. Forced ON for any
# non-local ENVIRONMENT by the startup hardening, because a deployed log is read
# by a shipper — and because structure carried by an encoder rather than by
# punctuation is what stops a user-controlled value (a path, an email, an
# upstream error) pretending to be a field. Leave false locally, where a person
# is reading a terminal.
LOG_JSON=false

# --- PostgreSQL (asyncpg driver) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-in-prod

# --- Redis (Celery broker + result backend) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Required: an unauthenticated Redis broker is remote code execution.
REDIS_PASSWORD=redis-dev-password

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Startup fails in production if this is left as a placeholder.
JWT_SECRET_KEY=change-me-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900         # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800     # 7 days
SESSION_ABSOLUTE_LIFETIME_SECONDS=2592000  # 30 days — hard cap per login
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_PATH=/api/v1/auth     # must match where the auth routes are mounted

# --- Registration & abuse protection ---
# Registration is OPEN. (The invite-code gate this comment used to describe was
# removed with P0: a fresh account belongs to no organisation and can reach
# nothing until it redeems an activation code or accepts an invitation.)
AUTH_RATE_LIMIT_ATTEMPTS=10          # per IP per window on /register /login /refresh
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Refuse passwords already published in a breach corpus, via Have I Been Pwned's
# range API. k-anonymous: only the first 5 characters of the candidate's SHA-1
# leave this process, and the check fails OPEN, so HIBP being down costs a round
# trip rather than a closed signup form. Set false to switch it off entirely.
PASSWORD_BREACH_CHECK_ENABLED=true
PASSWORD_BREACH_CHECK_TIMEOUT_SECONDS=2.0
# Per-tenant resource bounds. NOT commercial tiers — max_workspaces/max_managers
# live on the subscription row because they are what a customer bought. These
# are safety bounds on shared storage, set far above any real use: a tenant that
# reaches one has stopped using the feature and started filling the database.
MAX_COST_PRICE_ROWS_PER_WORKSPACE=100000
MAX_AB_TESTS_PER_WORKSPACE=500
# Comments are bounded by date rather than count: they carry no workspace column
# to count against, and a note dated a year out describes nothing anyone reads.
SKU_COMMENT_MAX_DAYS_FROM_TODAY=400
# Tenancy enforced by PostgreSQL row-level security, not only by
# every query remembering its WHERE. Leave false until BOTH sql scripts are
# applied — scripts/sql/least_privilege_role.sql first (the policies are inert
# for a table owner, which the app is until then), then row_level_security.sql.
# Turn this ON before applying the second one: binding a setting no policy reads
# is harmless, while policies with nothing binding the setting make every
# tenant-scoped query raise.
ROW_LEVEL_SECURITY_ENABLED=false
# The database role the API — and ONLY the API — connects as. Left empty every
# service uses POSTGRES_USER above, which is the owner, and nothing differs.
#
# Set these after applying scripts/sql/least_privilege_role.sql. Do NOT instead
# change POSTGRES_USER: every service shares this file, so that would switch
# `migrate` (which runs DDL and would lose the right to) and `worker`/`beat`
# (whose nightly harvests cross every workspace and bind no tenant, so they
# would start raising once the row-level policies are on).
APP_POSTGRES_USER=
APP_POSTGRES_PASSWORD=

# --- Outbound email: confirmation and password reset ---
# EVERYTHING HERE IS OFF BY DEFAULT, and the app refuses to boot on an
# incoherent pair — a flow that needs mail with no transport to send it fails at
# the registration form rather than at the thing that is broken.
#
# With EMAIL_ENABLED=false the transport is the logging one: messages are
# rendered into the application log instead of sent. That is correct for local
# and CI (the code is readable in your console, no test can mail a stranger),
# and it is what production runs until the four lines below are filled in.
EMAIL_ENABLED=false
SMTP_HOST=
# 587 is the usual STARTTLS submission port and the right default. Check it is
# actually reachable from the host before trusting it: this project's host filters
# outbound SMTP by port — 25, 465 and 587 all blocked, 2465 and 2587 open — so
# production runs 2587, the provider's alternate STARTTLS port. The symptom of
# getting this wrong is not an error at boot; it is every registration spending
# SMTP_TIMEOUT_SECONDS blocked before the router swallows the failure.
#
# Only STARTTLS ports work here. SMTP_USE_TLS means STARTTLS, never
# TLS-on-connect, so an implicit-TLS port (465, 2465) needs code that does not
# exist yet.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Only ever false for a relay on a trusted local network: plaintext SMTP hands
# every reset code to anyone on the path. Startup refuses false when enabled.
SMTP_USE_TLS=true
# Must be on a domain whose SPF/DKIM authorise this sender, or the mail lands in
# spam and the feature fails silently for the users least able to diagnose it.
EMAIL_FROM=
EMAIL_FROM_NAME=Marketplace Analytics
SMTP_TIMEOUT_SECONDS=10.0

# Turn these on only once EMAIL_ENABLED=true and a test message has arrived.
# Required: an unconfirmed address cannot redeem an activation code or accept an
# invitation. Deliberately NOT a login gate — see require_confirmed_email.
EMAIL_CONFIRMATION_REQUIRED=false
# Off, /password-reset/request REFUSES with "временно недоступно" rather than
# answering 202 like a successful request. That is deliberate and it is visible
# to users: the SPA has a reset form, and a 202 would tell somebody a code was
# sent by a deployment that cannot send one. The uniform answer that matters —
# a registered address and an unknown one being indistinguishable — is per
# address and is unaffected.
PASSWORD_RESET_ENABLED=false
VERIFICATION_CODE_TTL_SECONDS=1200
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LENGTH=6

# --- CORS (browser frontend) ---
# In production nginx serves the SPA and the API from the SAME origin (the
# /api/ reverse proxy), so CORS is unnecessary. Keep it true locally for the
# cross-origin Vite dev server (localhost:5173).
#
# NOT optional on a deployed environment: any ENVIRONMENT other than `local`
# REFUSES TO START with this true. CORS is what decides whether
# somebody else's page may read our authenticated responses, and the default
# here is `true` — so the guard exists because one dropped line would otherwise
# have re-enabled it in silence.
CORS_ENABLED=true
# Allowed origins (JSON array when overriding via env):
# CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]

# --- Workspace token encryption ---
# WB API tokens live ENCRYPTED in the database, one set per workspace
# (workspaces.workspace_tokens) — they are no longer environment variables.
# This Fernet key encrypts/decrypts them. Startup fails in production if unset.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=

# --- WildBerries API (transport only — tokens are per-workspace, in the DB) ---
WB_ANALYTICS_BASE_URL=https://seller-analytics-api.wildberries.ru
WB_ADVERTISING_BASE_URL=https://advert-api.wildberries.ru
WB_CONTENT_BASE_URL=https://content-api.wildberries.ru
WB_PRICES_BASE_URL=https://discounts-prices-api.wildberries.ru
WB_STATISTICS_BASE_URL=https://statistics-api.wildberries.ru
# Public storefront card endpoint (final customer price after all discounts).
WB_CARD_BASE_URL=https://card.wb.ru
WB_CARD_DEST=-1255563
WB_CARD_SPP=30
# Optional forward proxy for card.wb.ru ONLY. Leave EMPTY for a clean egress IP
# (local dev). Set a residential/mobile proxy on hosts whose IP the storefront
# edge blocks (e.g. prod), e.g. http://user:pass@host:port . Holds credentials.
WB_CARD_PROXY=
WB_CARD_CONNECT_TIMEOUT_SECONDS=15
WB_CARD_MAX_RETRIES=3
# --- FBS (seller-owned warehouses) ---
# Every warehouse WB lists for the seller is discovered and harvested; set this
# to false to switch FBS off entirely.
WB_FBS_HARVEST_ENABLED=true
# Display labels by WB warehouse id, for warehouses whose own name should not
# become a column header. Anything absent is labelled from WB's name on first
# sight. READ ONCE PER WAREHOUSE, then frozen in monitoring.fbs_warehouse:
# stock_snapshot.warehouse_name is a primary key, so editing an entry after a
# warehouse has been harvested starts a NEW column and orphans its stock
# history and «Отгрузить» marks under the old label. Set it BEFORE the first
# harvest that sees the warehouse.
WB_FBS_WAREHOUSE_LABELS={"9945803": "Внуково - Москва (FBS)", "9990254": "Белая дача - Москва (FBS)"}
WB_HTTP_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Database backups (backend/scripts/backup/ — cron, 03:00 Europe/Moscow)
# ---------------------------------------------------------------------------
# The ONLINE half of the age key pair the nightly dump is encrypted to. It
# exists so the Sunday restore rehearsal can decrypt the artifact unattended;
# anyone with a shell here can read any archive with it, which is the accepted
# price of keeping that rehearsal. The public keys — this one and the OFFLINE
# one, whose private half belongs in a password manager and must never be on a
# server — are in scripts/backup/recipients/database.txt.
#
# Generate a pair with:  age-keygen
#   the AGE-SECRET-KEY-1… line goes here, the public key goes in that file.
BACKUP_ENCRYPTION_IDENTITY=

# The old symmetric passphrase. NOT used to write anything since 2026-09-21,
# and still required: monthly/ keeps gpg artifacts for 365 days, and the last
# one written was monthly/marketplace-20260901T030002msk.sql.gz.gpg — so this
# must stay here, and in the password manager, until 2027-09-01. restore.sh picks
# the scheme from the file extension, so the only way to get this wrong is to
# delete the key early.
BACKUP_ENCRYPTION_KEY=

# Optional: failures (and the weekly restore-rehearsal result) reach a human.
# Left empty the job is silent, but still exits non-zero on failure.
BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=

# Everything below has a working default in scripts/backup/lib/config.sh and is
# only worth setting when a deployment differs:
# BACKUP_WORK_DIR=/var/backups/marketplace
# BACKUP_DOCKER_NETWORK=marketplace-service_default
# BACKUP_MIN_BYTES=10485760      # absolute floor for the compressed dump
# BACKUP_SHRINK_PCT=50           # fail below this share of the previous run
# BACKUP_LOCAL_KEEP=3            # encrypted dumps kept on the host
# BACKUP_SECRETS_FILES=          # what backup_secrets.sh bundles (default: this file)

# --- Object storage: Hoster S3 ---
S3_HOSTER_URL=https://s3.storage.example
S3_HOSTER_BUCKET=
S3_HOSTER_ACCESS_KEY=
S3_HOSTER_SECRET_ACCESS_KEY=
HOSTER_DEFAULT_REGION_NAME=ru-1

# --- Object storage: Cloudflare R2 ---
# (The CLOUDFARE spelling is the one already in use across the deployment.)
S3_CLOUDFARE_URL=https://<account-id>.r2.cloudflarestorage.com
S3_CLOUDFARE_BUCKET=
S3_CLOUDFARE_ACCESS_KEY=
S3_CLOUDFARE_SECRET_ACCESS_KEY=
CLOUDFARE_DEFAULT_REGION_NAME=auto

# ---------------------------------------------------------------------------
# Observability: metrics, error reporting, log rotation
# ---------------------------------------------------------------------------

# --- Prometheus ---
# The exposition route on the API. On by default: the counters cost a few
# hundred floats, and a metric not recorded is gone forever while an error not
# reported is still in the logs. Prometheus reaches it over the internal Docker
# network; nginx does not proxy it.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Optional bearer token for /metrics. Leave EMPTY unless the API's port is
# published or a second ingress is put in front of it — the network topology is
# the control today. If you set it, write the same value into a file and point
# Prometheus at it (see the commented `authorization` block in
# backend/docker/observability/prometheus.yml); it must not be inline there,
# because that file is in git.
METRICS_TOKEN=

# The Celery worker's own exporter. Not published to the host.
WORKER_METRICS_PORT=9100

# PROMETHEUS_MULTIPROC_DIR is deliberately NOT listed with an empty value, and
# this comment is here so nobody helpfully adds it back.
#
# `prometheus_client` decides whether metrics are multiprocess-backed by asking
# whether the variable is PRESENT, not whether it has a value — so
# `PROMETHEUS_MULTIPROC_DIR=` puts every metric into multiprocess mode against a
# path of "". Listing it empty here crashed every API container in the CI
# end-to-end job, which copies this file to .env verbatim.
#
# docker-compose.yml sets it on the WORKER only, where the prefork pool actually
# needs it. `src/core/observability/metrics.py` now also deletes an empty one
# defensively; both belong, because the trap is invisible until it is deployed.

# --- Sentry ---
# Reporting is ON if and only if a DSN is present — there is no separate enable
# flag, because a flag can disagree with the DSN and the direction it disagrees
# in is always "we believe we are reporting errors that nothing receives".
# Get one from https://sentry.io → the project → Settings → Client Keys (DSN).
SENTRY_DSN=

# Fraction of transactions traced. Tracing is the expensive half of Sentry and
# the value here is errors, not spans; 0.0 keeps a 2 vCPU box out of it.
SENTRY_TRACES_SAMPLE_RATE=0.0

# Sentry's own PII collection: request bodies, cookies, headers, the user's
# address. Leave FALSE. This API's request bodies carry passwords, reset codes
# and WB seller tokens, and Sentry's scrubbing is a denylist we do not control.
# The log context (trace/tenant/workspace/account) is attached instead.
SENTRY_SEND_DEFAULT_PII=false

# --- Log rotation ---
# Containers log to stdout and Docker's json-file driver rotates it — capped at
# 20 MB x 3 per service in docker-compose.yml, which is the layer that actually
# protects the disk. LOG_FILE is for a process run OUTSIDE Docker (a script on
# the box, a systemd unit); leave it empty in every container.
LOG_FILE=
LOG_FILE_MAX_BYTES=20971520
LOG_FILE_BACKUP_COUNT=3

# --- Alerting (Alertmanager -> Telegram) ---
# Where a firing Prometheus rule ends up. Left empty, the renderer falls back to
# the BACKUP_ALERT_TELEGRAM_* pair above, which is the bot the backup job has
# used since it was written — so alerting works with the credentials already on
# the box. Set these to split monitoring alerts onto their own bot or chat.
#
# These are read by scripts/observability/render_alertmanager_config.sh, which
# generates docker/observability/alertmanager.yml (gitignored) at `make obs-up`.
# Alertmanager has no env-var substitution of its own, which is why the config is
# rendered rather than committed.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Grafana ---
# Read by docker-compose.observability.yml. Grafana binds 127.0.0.1:3000 and is
# reached over an SSH tunnel, never published — but it holds a read view of
# every metric this service produces, so the password is not a formality.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# A/B-test variant photos. The bucket falls back to S3_HOSTER_* when these are
# unset, so a deployment that already has those needs nothing here. Leave the
# bucket empty to store photos in a local directory instead — that is for tests
# and single-process development only: a deployed api and worker do not share a
# filesystem, so the rotation would not find what the upload wrote.
AB_TESTS_S3_BUCKET=
AB_TESTS_S3_ENDPOINT_URL=
AB_TESTS_S3_ACCESS_KEY=
AB_TESTS_S3_SECRET_KEY=
AB_TESTS_MEDIA_PREFIX=ab-tests
