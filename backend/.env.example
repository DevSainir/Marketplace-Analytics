# ---------------------------------------------------------------------------
# Marketplace Service — environment template.
# Copy to `.env` and fill real secrets. NEVER commit the populated `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Marketplace Service"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL (asyncpg driver) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-in-prod

# --- Redis (Celery broker + result backend) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-super-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900         # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=604800     # 7 days
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_PATH=/api/v1/auth     # must match where the auth routes are mounted

# --- CORS (browser frontend origins; JSON array when overriding via env) ---
# CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]

# --- WildBerries API tokens (per API surface) ---
WB_ANALYTICS_TOKEN=
WB_ADVERTISING_TOKEN=
WB_ANALYTICS_BASE_URL=https://seller-analytics-api.wildberries.ru
WB_ADVERTISING_BASE_URL=https://advert-api.wildberries.ru
WB_CONTENT_BASE_URL=https://content-api.wildberries.ru
WB_HTTP_TIMEOUT_SECONDS=30
