# ---------------------------------------------------------------------------
# Where an alert goes once Prometheus decides it is firing.
#
# THIS FILE IS A TEMPLATE, and the reason is the bot token. Alertmanager has no
# environment-variable substitution of its own and no `chat_id_file` to pair
# with its `bot_token_file`, so a working config either carries a live
# credential or is generated. It is generated:
# `scripts/observability/render_alertmanager_config.sh` renders this into
# `alertmanager.yml` (gitignored) from backend/.env, and `make obs-up` runs the
# renderer first. Placeholders below are filled by that script and by nothing
# else.
#
# Telegram, because that is where this team already looks: the backup job has
# alerted there since it was written, and an alert delivered somewhere nobody
# reads is indistinguishable from no alert. The renderer falls back to the
# backup job's own bot when no dedicated one is configured, so this works with
# the credentials already on the box and can be split onto its own bot later
# without touching anything here.
# ---------------------------------------------------------------------------

route:
  # Group by alert NAME and severity rather than by instance. An outage that
  # takes both API instances down should arrive as one message naming both, not
  # as two messages five seconds apart — the second one tells you nothing and
  # is the one that trains people to swipe the notification away.
  group_by: ["alertname", "severity"]
  # Wait this long for siblings before sending the first message. Failures
  # arrive in clusters here (Redis down takes the rate limiter and session
  # revocation with it), so half a minute buys a single coherent message.
  group_wait: 30s
  # Before sending an update about a group that has already alerted.
  #
  # Half an hour, not five minutes, and the difference is not taste. A group is
  # re-notified whenever its MEMBERSHIP changes, not only when it first fires,
  # so an alert whose instance set churns re-sends the entire group every time
  # one endpoint joins or leaves. On 2026-09-07 that produced seven identical
  # three-endpoint messages in ten hours from a service with nothing wrong with
  # it: `WbRateBudgetExhausted` was built on a gauge that vanished and returned
  # with each Celery child recycle (see the long note in alerts.yml). The rule
  # is fixed, but the amplifier was this interval, and any future flapping rule
  # would find it again.
  group_interval: 30m
  # Before repeating an alert nobody has resolved. Four hours: long enough not
  # to be noise, short enough that an overnight outage is still shouting in the
  # morning.
  repeat_interval: 4h
  receiver: telegram

  routes:
    # `severity: page` alerts skip the grouping delay. The difference between
    # `page` and `warn` in alerts.yml is whether somebody should stop what they
    # are doing, and a 30-second wait on the RLS-violation alert would be 30
    # seconds of a tenant boundary being tested unobserved.
    - matchers: ["severity = page"]
      receiver: telegram
      group_wait: 0s
      # And keeps the SHORT group interval the default route gave up. That
      # interval delays every update to a group that has already alerted, and
      # a resolution is an update — so inheriting 30m here would hold "the site
      # is back" for half an hour after it was. Page alerts are rare enough
      # that throttling them is not what the interval is for.
      group_interval: 5m
      repeat_interval: 1h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "__TELEGRAM_BOT_TOKEN__"
        chat_id: __TELEGRAM_CHAT_ID__
        # HTML rather than Markdown: an alert's description can contain
        # underscores and asterisks (metric names, label values), and Telegram's
        # Markdown parser REJECTS the whole message when they do not pair up.
        # A monitoring system whose alerts fail to send because a metric was
        # called `wb_api_requests_total` is worse than no formatting.
        parse_mode: HTML
        send_resolved: true
        # The shape of this message is deliberate, and the thing it is
        # avoiding is a wall of repeated prose. `description` is a constant per
        # RULE while `summary` is templated per instance, so a three-endpoint
        # group used to arrive as the same five-line paragraph three times with
        # one distinguishing line buried in each copy. Read on a phone that is
        # indistinguishable from one long alert, which is how a real one gets
        # swiped away.
        #
        # So: a headline that says which alert and how many instances, the
        # instances as a scannable list, and the explanation ONCE at the
        # bottom. `.CommonAnnotations` holds an annotation only when every
        # alert in the group agrees on it — which is exactly the condition
        # under which printing it once is correct — and the `else` branch
        # falls back to per-alert descriptions for a rule that templates
        # labels into one.
        #
        # The severity emoji splits 🔴 from 🟡 because `page` and `warn` mean
        # different things (stop what you are doing / look before the end of
        # the day) and arrived looking identical.
        #
        # The status line is Russian, as are the `summary` and `description`
        # annotations it wraps: this message is read on a phone by the people
        # who run the service, not by Prometheus. `alertname` stays as it is —
        # it is the identifier you type into Grafana, not prose. And the count
        # is rendered as «затронуто: N» rather than a noun, because Russian
        # needs three plural forms for that noun and a template is the wrong
        # place to get them wrong.
        message: |
          {{ if eq .Status "firing" }}{{ if eq .CommonLabels.severity "page" }}🔴{{ else }}🟡{{ end }}{{ else }}✅{{ end }} <b>{{ .CommonLabels.alertname }}</b>
          {{ if eq .Status "firing" }}сработал{{ else }}в норме{{ end }}{{ with .CommonLabels.severity }} · {{ if eq . "page" }}срочно{{ else }}посмотреть{{ end }}{{ end }} · затронуто: {{ len .Alerts }}

          {{ range .Alerts }}• {{ .Annotations.summary }}
          {{ end }}
          {{ with .CommonAnnotations.description }}<i>{{ . }}</i>{{ else }}{{ range .Alerts }}{{ with .Annotations.description }}<i>{{ . }}</i>
          {{ end }}{{ end }}{{ end }}

inhibit_rules:
  # When both API instances are down, do not also send the per-instance alert
  # for each of them. The specific fact ("the site is down") should not arrive
  # buried between two general ones.
  - source_matchers: ["alertname = BothApiInstancesDown"]
    target_matchers: ["alertname = ApiDown"]
    equal: ["severity"]
