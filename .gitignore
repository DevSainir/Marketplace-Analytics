# ---- OS / editors ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---- Secrets / env ----
.env
.env.*
!.env.example
*.local

# ---- Docker (local-only overrides) ----
# The override publishes dev ports on loopback and must never reach the VPS:
# `make up` there runs the closed base topology.
backend/docker/docker-compose.override.yml

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ---- Node / frontend ----
# Consolidated here from frontend/.gitignore: one file to read, and no way for
# the two to disagree about what is ignored in the same tree.
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
.npm-cache/
frontend/.npm-cache/
tests/.npm-cache/
backend/.cache/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Tests ----
# Playwright evidence (traces, video, screenshots) and its HTML report: written
# on every failing run and regenerated from scratch, never reviewed in a diff.
tests/.artifacts/
tests/.report/
playwright-report/
test-results/
# k6 summary exports.
tests/performance/**/*.summary.json

# ---- Tooling ----
.pre-commit-cache/
# Wheels pip occasionally leaves in the working directory (e.g. when a
# hash-checking resolve has to build one). Never an artefact worth keeping.
*.whl

# ---- Private operational notes ----
# Private, per-machine notes kept beside the skills. The skills are tracked;
# these notes are not.
.claude/skills/**/*.local.md

# Rendered from backend/docker/observability/alertmanager.yml.template by
# backend/scripts/observability/render_alertmanager_config.sh at `make obs-up`.
# Holds the live Telegram bot token — Alertmanager has no environment-variable
# substitution, so the config is generated rather than committed.
backend/docker/observability/alertmanager.yml

# prometheus_client multiprocess mmap files. They should only ever appear under
# PROMETHEUS_MULTIPROC_DIR (a tmpfs on the worker); one turning up here means
# the variable was set but empty, which makes the library write to the CWD.
# That happened once — see tests/unit/core/test_metrics_bootstrap.py.
*_[0-9]*.db

# Frontend releases staged by `make frontend-release` (see the Makefile).
# Local state: the built bundle plus the nginx config that serves it, kept
# beside the running one so a new release is a symlink flip and a reload.
.frontend-releases/
