# Base URL of the FastAPI backend, including the shared /api prefix.
#
# LEAVE IT UNSET unless you are pointing a build at a REMOTE backend. The app
# already falls back to the relative `/api` (see src/core/api/axios.js), which
# is the correct value in both environments that actually exist:
#   dev  — the Vite dev server proxies /api/* to localhost:8000 (vite.config.js)
#   prod — nginx reverse-proxies /api/ to the api container (docker/nginx.conf)
#
# Setting it to `/api` here would be a no-op, so this file ships the variable
# commented out: copying it gives you a working config, not a redundant one.
#
# VITE_API_URL=https://staging.example.com/api
